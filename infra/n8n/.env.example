# 복사해서 infra/n8n/.env로 쓴다(.env는 Git에 올리지 않는다). 아래 값은 예시이며 실제 비밀값이 아니다.
# docker compose와 make_credentials.py가 이 파일을 읽는다. 필수 값이 비면 make_credentials.py가 변수 이름을 말하고 멈춘다.

# n8n 게시 주소. VPN(team-d) 연결 전 127.0.0.1, 연결 뒤 10.250.0.100
BIND_IP=127.0.0.1

# [필수] Graylog 알림 → n8n 웹훅 헤더(X-Haedam-Key). Graylog 알림 설정에도 같은 값을 넣는다.
# 생성 예(PowerShell): -join (1..48 | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
N8N_WEBHOOK_KEY=change-me-webhook-key

# [필수] 포털 대응 API 키(X-Response-Key). services/portal/backend .env의 RESPONSE_API_KEY와 같은 값
PORTAL_RESPONSE_KEY=change-me-portal-response-key

# [필수] 티켓 저장소 키. services/ticket-store/.env의 TICKET_STORE_KEY와 같은 값
TICKET_STORE_KEY=change-me-ticket-store-key

# [필수] Wazuh API 계정(haedam-17 S7 복구 호출). infra/wazuh/.env의 WAZUH_API_PASSWORD와 같은 값
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me-same-as-infra-wazuh-env

# [필수] pfSense 대응 도구 SSH 개인키 파일 경로(저장소 밖에 둔다). 공개키는 pfSense admin에 from=10.250.0.100 제한으로 등록
PF_SSH_PRIVATE_KEY_FILE=C:/Users/<사용자>/.ssh/haedam_pf_response
PF_SSH_HOST=10.250.0.1
PF_SSH_USER=admin

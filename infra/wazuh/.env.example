# 복사해서 infra/wazuh/.env로 쓴다(.env는 Git에 올리지 않는다).
# docker-compose.yml은 비밀번호를 직접 적지 않고 이 값을 읽는다. 값이 비면 compose가 변수 이름을 말하고 멈춘다.

# 게시 주소. VPN(team-c) 연결 전 127.0.0.1, 연결 뒤 10.250.0.3
BIND_IP=127.0.0.1

# Wazuh 내부 계정. config/wazuh_indexer/internal_users.yml의 해시와 짝이 맞아야 한다.
# - 처음 설치: wazuh-docker v4.9.0 single-node 공식 기본값을 넣으면 그대로 동작한다
#   (https://documentation.wazuh.com/4.9/deployment-options/docker/wazuh-container.html 의 기본 계정 표).
# - 바꾸려면: 공식 문서의 "Change the password of Wazuh users" 절차로 internal_users.yml 해시도 함께 바꾼다.
WAZUH_INDEXER_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=
# Wazuh API(wazuh-wui) 비밀번호. infra/n8n/.env의 WAZUH_API_PASSWORD와 같은 값
WAZUH_API_PASSWORD=
